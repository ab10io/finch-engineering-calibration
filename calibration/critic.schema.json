{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["valid", "errors"],
  "properties": {
    "valid": { "type": "boolean" },
    "errors": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }
  }
}
